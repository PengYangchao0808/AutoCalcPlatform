  "spec": "runtime/application-api.v1.json#canonical_digest",
  "implementation_owner": "B16 (src/acp_services/runtime/canonical_digest.py)",
  "purpose": "Byte-for-byte conformance vectors so B16's implementation can be reproduced exactly. B03 does not implement the runtime function.",
  "algorithm": {
    "signature": "canonical_digest(value: dict, *, set_fields: tuple[str, ...] = (), drop_fields: tuple[str, ...] = ()) -> str",
    "steps": [
      "reject a non-object root (root_not_object)",
      "drop the top-level keys listed in drop_fields",
      "reject JSON null anywhere (null_in_digest_input)",
      "reject JSON float anywhere (non_canonical_number); integers are kept",
      "treat an object whose keys are exactly {value, unit} as a quantity: convert to the dimension base unit with Decimal(precision=28, ROUND_HALF_EVEN) and emit {unit, value} with a canonical decimal string",
      "reject a key that does not match ^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$ (non_canonical_key)",
      "sort object keys by code point",
      "sort a list only when its parent key is listed in set_fields, by the canonical JSON string of each element",
      "serialize with json.dumps(sort_keys=True, separators=(',', ':'), ensure_ascii=False) and UTF-8 encode",
      "digest = 'sha256:' + hex(sha256(bytes))"
    ],
    "decimal_input_rule": "a quantity value is an integer or a plain-decimal string (no exponent, no leading zeros); trailing zeros are allowed on input and normalized away on output",
    "decimal_output_pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
    "units": {
