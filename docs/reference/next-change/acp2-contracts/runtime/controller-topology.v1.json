    ],
    "cwd": "/ACPServer/acp2-development/data/b/controller-config",
    "db_path": "/ACPServer/acp2-development/data/b/run-root/acp_jobs.db",
    "run_root": "/ACPServer/acp2-development/data/b/run-root",
    "release": "a3ff3c5c4725d3e5bec8a7cb196b81c85a0da45e",
    "release_source": "git rev-parse HEAD of /ACPServer/AutoCalcPlatform (B04a working tree; frozen B candidate a0185b1 remains the acceptance baseline)",
    "interpreter": "/ACPServer/acp2-development/venvs/b/bin/python",
    "pythonpath": "/ACPServer/AutoCalcPlatform/src",
    "config": "/ACPServer/acp2-development/data/b/controller-config/cccp.yaml",
    "endpoints_probed": [
      "http://127.0.0.1:18765/api/health",
      "http://127.0.0.1:18765/api/capabilities",
      "http://127.0.0.1:18765/api/v1/jobs"
    ],
    "start_record": "reports/acp2_implementation/bb45a46/B/B04/controller-start-record.json"
  },
  "cli_target": {
    "spelling": "--controller",
    "scope": "shared acp task parser (all subcommands)",
    "supported_commands": [
      "query",
      "execute",
      "pause",
      "unpause",
      "continue",
      "cancel",
      "rerun"
    ],
    "lock_refusal": {
      "condition": "a live Controller owns the resolved run root and --controller is absent",
      "applies_to": [
        "execute",
        "pause",
        "unpause",
        "continue",
        "cancel",
        "rerun"
      ],
      "reason": "controller_running_use_--controller",
      "read_only_exception": "query may read the store without claiming run-root ownership"
    }
  },
  "b04b_boundary": {
    "owner": "B07/H2 (B04b)",
    "not_closed_by_b04a": [
      "two MCP adapters start and exit against one Controller",
      "MCP stdio transport and handshake",
      "task count unchanged across adapter start/exit"
    ],
    "closed_by_b04a": [
      "one Controller per run root",
      "second Controller refused before any worker/submission",
      "loopback ControllerClient read-only surface",
      "acp task --controller query/control/execute targeting",
      "live entry-readonly discovery receipt"
    ]
  },
  "gaps_closed": [
    "GAP-B03-04 (Controller target and ControllerClient)"
  ],
  "references": {
    "application_api": "docs/reference/next-change/acp2-contracts/runtime/application-api.v1.json",
    "acceptance_harness": "docs/reference/next-change/acp2-contracts/runtime/acceptance-harness.v1.md",
    "manager_lock": "src/acp/scheduler/manager.py",
    "composition_root": "src/acp/api/server.py::create_app",
    "evidence": "reports/acp2_implementation/bb45a46/B/B04/"
  }
}
