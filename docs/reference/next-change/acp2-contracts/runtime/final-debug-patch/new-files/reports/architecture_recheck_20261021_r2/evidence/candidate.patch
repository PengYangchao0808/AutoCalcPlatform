+        "work_dir": work_dir,
+        "artifacts": artifacts[:20],
+        "stderr_tail": (result.stderr or "").strip().splitlines()[-3:],
+        "ok": result.returncode == 0 and status == "completed" and bool(artifacts),
+    }
