  "b18": {
    "owner": "B",
    "split": {
      "B18a": "contract conversion (separately consumable by C18)",
      "B18b": "execution wiring (one TaskRef, persistent bounded steps)",
      "B18c": "recovery/publication verification (static/simulated)"
    },
    "a_contract_conversion": {
      "schema": "acp2.runtime.science-binding.a-conversion.v1",
      "consumes": "science_contracts.entries",
      "roundtrip_schema": "acp2.runtime.science-roundtrip.v1",
      "c_form_producer": "C T-17 (model-free manual research form)",
      "c_form_fixture": "runtime/samples/science-binding/b18/p2-minimal-form.json",
      "full_dynamic_form": "C T-38/H5; never a B18 gate",
      "does_not_copy_parsers": true,
      "preserves": [
        "structure reference",
        "method",
        "basis",
        "solvent",
        "charge",
        "multiplicity",
        "atom-mapping identity",
        "resources"
      ],
      "negative": "atom_mapping_mismatch (rejected before adoption)"
    },
    "step_dag": {
      "schema": "acp2.runtime.step-dag.v1",
      "representation": "one_platform_task_multiple_persistent_steps",
      "task_ref_rule": "exactly one TaskRef for the whole bounded DAG",
      "bounded_acyclic_only": true,
      "arbitrary_branching": false,
      "second_orchestrator": false,
      "max_steps_default": 8,
      "max_consumers_per_step_default": 1,
      "step_kinds": [
        "singlepoint",
        "optimize",
        "frequency",
        "irc"
      ],
      "irc": {
        "bounded_step_kind": true,
        "task_kind_source": "cccp.calculation.requests.TaskKind.IRC",
        "entrypoint": "cccp.calculation.run_irc",
        "legacy_independent_irc_path_preserved": true
      },
      "execution_unit": {
        "loop_owner": "acp_services.runtime.step_dag.BoundedStepDagExecutor",
        "compute_owner": "cccp.calculation.tasks"
      },
      "output_ref": [
        "from_step",
        "product_kind",
        "expected_digest",
        "required"
      ],
      "step_fields": [
        "step_id",
        "ScienceStepKind",
        "capability",
        "input types (consumes OutputRef)",
        "output types (produces OutputRef)",
        "structure_role",
        "implementation_version",
        "parameters",
        "max_attempts",
        "qc_invocations",
        "bsub"
      ],
      "step_states": [
        "pending",
        "ready",
        "running",
        "completed",
        "blocked",
        "upstream_failed",
        "failed",
        "cancelled"
      ],
      "publish_states": [
        "not_published",
        "published",
        "failed"
      ],
      "control": [
