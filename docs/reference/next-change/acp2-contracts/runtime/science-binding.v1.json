{
  "schema": "acp2.runtime.science-binding.v1",
  "contract_version": "1.0.0",
  "frozen_at": "2026-10-22",
  "owner": "B",
  "status": "delivered",
  "scope": "The binding between one ACP application submit and the cccp task request that actually executes. Proof that the platform carries scientific intent without rewriting it.",
  "ownership_rule": "A owns science semantics (what a capability means, which method/charge/spin is valid, which thresholds apply). B owns the envelope mapping and the execution identity. B NEVER invents, rewrites or 'repairs' a scientific default; empty values are filled only by cccp's translation layer from the single method metadata source.",
  "singlepoint": {
    "workflow": "singlepoint",
    "task_kind": "singlepoint",
    "task_kind_source": "cccp.calculation.requests.TaskKind.SINGLEPOINT",
    "plan": {
      "contract": "acp_services.runtime.plan_contracts.CalculationPlan",
      "builder": "acp.calculations.plans.build_simple_plan",
      "workflow": "singlepoint",
      "profile": "default",
      "items": "exactly one StructureArtifact (validate_plan rejects more than one)",
      "steps": [
        {
          "kind": "singlepoint",
          "mode": "unconstrained",
          "spec": null
        }
      ],
      "validate": "acp_services.runtime.plan_contracts.validate_plan"
    },
    "task_request": {
      "contract": "cccp.calculation.requests.TaskRequest",
      "schema_version": 1,
      "schema_version_source": "cccp.calculation.requests.TASK_REQUEST_SCHEMA_VERSION",
      "adapter": "acp.calculations.legacy_adapters.to_task_request",
      "execution_entry": "cccp.calculation.run_singlepoint(request, context=...)",
      "unknown_field_rule": "TaskRequest.from_dict ignores unknown inner fields (rule S2) while the application envelope rejects unknown envelope fields (application-api U1)"
    },
    "field_map": [
      {
        "source": "application submit.input.xyz_text|smiles|path",
        "target": "TaskRequest.structure",
        "target_type": "StructureInput",
        "required": true,
        "default": null,
        "unit": "none",
        "authority": "A produces the structure; B passes the reference through",
        "rule": "an inline geometry overrides a file when both are present (existing load_inputs precedence)"
      },
      {
        "source": "application submit.method.method",
        "target": "TaskRequest.level.method",
        "target_type": "string",
        "required": false,
        "default": "\"\" (translation layer fills from cccp method metadata)",
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.method.basis",
        "target": "TaskRequest.level.basis",
        "target_type": "string",
        "required": false,
        "default": "\"\" (translation layer fills)",
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.method.dispersion",
        "target": "TaskRequest.level.dispersion",
        "target_type": "string|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.method.solvent",
        "target": "TaskRequest.level.solvent",
        "target_type": "string|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.method.solvent_model",
        "target": "TaskRequest.level.solvent_model",
        "target_type": "string|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.method.integration_grid",
        "target": "TaskRequest.level.integration_grid",
        "target_type": "string|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.method.scf",
        "target": "TaskRequest.level.scf",
        "target_type": "string|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.charge",
        "target": "TaskRequest.charge",
        "target_type": "integer",
        "required": false,
        "default": 0,
        "unit": "elementary_charge",
        "authority": "A",
        "rule": "never inferred from a backend or a guessed valence"
      },
      {
        "source": "application submit.multiplicity",
        "target": "TaskRequest.multiplicity",
        "target_type": "integer",
        "required": false,
        "default": 1,
        "unit": "count (2S+1)",
        "authority": "A"
      },
      {
        "source": "application submit.backend",
        "target": "TaskRequest.backend",
        "target_type": "string|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A capability registry decides availability; B only forwards"
      },
      {
        "source": "application submit.method.electronic_state",
        "target": "TaskRequest.electronic_state",
        "target_type": "ElectronicStateSpec|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A (cccp electronic-state contract)"
      },
      {
        "source": "application submit.method.singlepoint_options.stability_check",
        "target": "TaskRequest.options[SinglePointOptions].stability_check",
        "target_type": "boolean|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "A"
      },
      {
        "source": "application submit.resources.cores",
        "target": "TaskRequest.resources.nproc",
        "target_type": "integer|null",
        "required": false,
        "default": null,
        "unit": "core",
        "authority": "B maps the reservation; A executes"
      },
      {
        "source": "application submit.resources.memory_mb",
        "target": "TaskRequest.resources.mem",
        "target_type": "integer|null",
        "required": false,
        "default": null,
        "unit": "megabyte",
        "authority": "B"
      },
      {
        "source": "application submit.resources.walltime_s",
        "target": "TaskRequest.resources.timeout_s",
        "target_type": "number|null",
        "required": false,
        "default": null,
        "unit": "second",
        "authority": "B"
      },
      {
        "source": "application submit.output_dir (server-resolved task work dir)",
        "target": "TaskRequest.output_dir",
        "target_type": "path|null",
        "required": false,
        "default": null,
        "unit": "none",
        "authority": "B",
        "rule": "resolved from the run root and the task dir name; never a client absolute path"
      }
    ],
    "envelope_only_fields": [
      {
        "field": "plan_digest",
        "owner": "B",
        "note": "execution identity, not science; never written into TaskRequest"
      },
      {
        "field": "proposal_digest",
        "owner": "B",
        "note": "research record projection; never written into TaskRequest"
      },
      {
        "field": "idempotency_key",
        "owner": "B",
        "note": "submission deduplication only"
      },
      {
        "field": "project_id",
        "owner": "B",
        "note": "workspace placement only"
      }
    ],
    "units": {
      "energy": "hartree (reported)",
      "length": "angstrom",
      "angle": "degree",
      "frequency": "cm^-1",
      "temperature": "kelvin",
      "time": "second",
      "memory": "megabyte",
      "spin": "multiplicity 2S+1"
    },
    "rejections": [
      {
        "condition": "plan has more than one item",
        "error": {
          "class": "invalid-parameter",
          "code": "input_invalid"
        },
        "source_rule": "validate_plan cardinality"
      },
      {
        "condition": "thermochemistry step without preceding frequency+singlepoint",
        "error": {
          "class": "invalid-parameter",
          "code": "input_invalid"
        },
        "source_rule": "validate_plan ordering"
      },
      {
        "condition": "unknown task kind",
        "error": {
          "class": "unsupported",
          "code": "unsupported_capability"
        },
        "source_rule": "TaskKind enum"
      },
      {
        "condition": "unknown TaskRequest schema_version",
        "error": {
          "class": "unsupported",
          "code": "unsupported_capability"
        },
        "source_rule": "TaskRequest.from_dict S1"
      },
      {
        "condition": "structure missing",
        "error": {
          "class": "invalid-parameter",
          "code": "input_invalid"
        },
        "source_rule": "TaskRequest validation"
      },
      {
        "condition": "non-finite number in a task payload",
        "error": {
          "class": "invalid-parameter",
          "code": "input_invalid"
        },
        "source_rule": "ensure_finite_payload (rule S4)"
      }
    ],
    "step_requirements": {
      "singlepoint": {
        "requires_geometry": true,
        "required_upstream": []
      },
      "source": "acp_services.runtime.step_requirements.STEP_REQUIREMENTS"
    },
    "serialization_sample": {
      "schema_version": 1,
      "task": "singlepoint",
      "charge": 0,
      "multiplicity": 1,
      "level": {
        "method": "r2SCAN-3c",
        "basis": "def2-mTZVPP"
      },
      "resources": {
        "nproc": 4,
        "mem": 2000
      },
      "structure": {
        "role": "minimum",
        "source": "xyz",
        "path": "input.xyz"
      }
    },
    "science_defaults_are_not_platform_defaults": "The sample above is an illustration of the wire shape. The effective method/basis for a submit come from A's method metadata via the translation layer; a platform-side table of scientific defaults is forbidden."
  },
  "reserved_science_contracts": {
    "rule": "B03 reserves the reference slots (schema id, version, digest) so the binding has a stable shape before A delivers. B never copies A's type definitions and never declares A's fields. When A delivers, B18 imports the id/version/digest and fills the digest; a renamed id is a versioned reference update, never a silent rename.",
    "consumers": [
      "B18 (Recipe/EvidenceReport binding)",
      "B20a (DA input contract)",
      "B21/B22 (plugin contract)"
    ],
    "entries": [
      {
        "schema_id": "acp2.science.capability-descriptor.v1",
        "owner": "A",
        "producer_task": "A-03",
        "version": "1.0.0",
        "digest_or_pending": "PENDING",
        "expected_path": "docs/reference/next-change/acp2-contracts/science/capability-descriptor.schema.json",
        "status": "reserved",
        "types_copied": false
      },
      {
        "schema_id": "acp2.science.recipe.v1",
        "owner": "A",
        "producer_task": "A-06/A-15",
        "version": "1.0.0",
        "digest_or_pending": "PENDING",
        "expected_path": "docs/reference/next-change/acp2-contracts/science/recipe.schema.json",
        "status": "reserved",
        "types_copied": false
      },
      {
        "schema_id": "acp2.science.evidence-report.v1",
        "owner": "A",
        "producer_task": "A-16",
        "version": "1.0.0",
        "digest_or_pending": "PENDING",
        "expected_path": "docs/reference/next-change/acp2-contracts/science/evidence-report.schema.json",
        "status": "reserved",
        "types_copied": false
      },
      {
        "schema_id": "acp2.science.reaction-spec.v1",
        "owner": "A",
        "producer_task": "A-14",
        "version": "1.0.0",
        "digest_or_pending": "PENDING",
        "expected_path": "docs/reference/next-change/acp2-contracts/science/reaction-spec.schema.json",
        "status": "reserved",
        "types_copied": false
      },
      {
        "schema_id": "acp2.science.provenance.v1",
        "owner": "A",
        "producer_task": "A-11/A-12",
        "version": "1.0.0",
        "digest_or_pending": "PENDING",
        "expected_path": "docs/reference/next-change/acp2-contracts/science/provenance.schema.json",
        "status": "reserved",
        "types_copied": false
      }
    ],
    "reference_shape": {
      "required": [
        "schema_id",
        "version",
        "digest"
      ],
      "fields": {
        "schema_id": {
          "type": "string",
          "pattern": "^acp2\\.science\\.[a-z0-9.-]+\\.v[0-9]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "A's schema document digest; PENDING until A delivers, and a PENDING reference is never executable"
        }
      }
    }
  },
  "compatibility": {
    "task_request_schema": 1,
    "rule": "a TaskRequest schema change is A's call; B follows with a binding version bump and a re-recorded mapping table",
    "binding_version": "1.0.0",
    "breaking_change_requires": [
      "new binding version",
      "updated field_map",
      "a positive and a negative sample",
      "a consumer confirmation note"
    ],
    "sample": "runtime/samples/science-binding/singlepoint-request.positive.json"
  }
}
