    "reference_shape": {
      "required": [
        "schema_id",
        "version",
        "digest"
      ],
      "fields": {
        "schema_id": {
          "type": "string",
          "pattern": "^acp2\\.science\\.[a-z0-9.-]+\\.v[0-9]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "A's schema document digest; PENDING until A delivers, and a PENDING reference is never executable"
        }
      }
    },
    "note": "Superseded by science_contracts at B18a. Retained for readers that still resolve this key; every entry is delivered with a real digest."
  },
