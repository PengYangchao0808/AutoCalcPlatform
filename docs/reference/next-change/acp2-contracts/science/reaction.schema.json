{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acp.local/acp2/science/reaction.schema.json",
  "title": "ACP2 Reaction",
  "description": "Frozen scientific reaction contract for ACP2. It describes a net reaction or a declared elementary step with stable atom identity on both sides, a one-to-one atom mapping, bond changes, per-species charge/multiplicity/stereochemistry, thermodynamic conditions and declared input uncertainty. JSON Schema validates structure only; element/stoichiometry conservation and map consistency are scientific-semantics rules (see semantic-rules.md). A net reaction never claims a single elementary step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reaction_id",
    "reaction_scope",
    "left",
    "right",
    "atom_mapping",
    "bond_changes",
    "conditions",
    "input_uncertainty"
  ],
  "propertyNames": {
    "not": {
      "enum": [
        "role",
        "model_role",
        "cost",
        "price",
        "job_status",
        "queue",
        "account"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "description": "Reaction contract major version. Unknown majors are rejected, never coerced."
    },
    "reaction_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable reaction identifier scoped to the contract document."
    },
    "reaction_scope": {
      "enum": [
        "net_reaction",
        "elementary_step"
      ],
      "description": "net_reaction is a multi-step transformation and must never be represented as one elementary step. elementary_step requires explicit supporting evidence outside this schema."
    },
    "left": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/structure_ref"
      },
      "description": "Reactant side. At least one species is required."
    },
    "right": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/structure_ref"
      },
      "description": "Product side. At least one species is required; removing the full side is incomplete, not a valid transformation."
    },
    "atom_mapping": {
      "$ref": "#/$defs/atom_mapping"
    },
    "bond_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/bond_change"
      },
      "description": "Declared bond changes. Classification mirrors cccp.analysis.pes.bond_changes (form -> formed, break -> broken, order_up/order_down -> changed)."
    },
    "conditions": {
      "$ref": "#/$defs/conditions"
    },
    "input_uncertainty": {
      "$ref": "#/$defs/input_uncertainty"
    }
  },
  "$defs": {
    "atom_address": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$",
      "description": "Canonical stable atom address '<structure_id>:<atom_id>'. Both parts are serialized fields, never derived from array position."
    },
    "stereo_center": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "atom_id",
        "configuration"
      ],
      "properties": {
        "atom_id": {
          "type": "string",
          "minLength": 1
        },
        "configuration": {
          "enum": [
            "R",
            "S",
            "unknown"
          ],
          "description": "unknown is a preserved input fact, never replaced by an inferred R/S assignment."
        }
      }
    },
    "stereo_double_bond": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "atom_ids",
        "configuration"
      ],
      "properties": {
        "atom_ids": {
          "type": "array",
          "prefixItems": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "configuration": {
          "enum": [
            "E",
            "Z",
            "unknown"
          ],
          "description": "unknown is preserved, never silently assigned."
        }
      }
    },
    "stereochemistry": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "status",
        "centers",
        "double_bonds"
      ],
      "properties": {
        "status": {
          "enum": [
            "defined",
            "partially_defined",
            "unknown"
          ],
          "description": "unknown must remain unknown; the contract never invents a configuration."
        },
        "centers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stereo_center"
          }
        },
        "double_bonds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/stereo_double_bond"
          }
        }
      }
    },
    "structure_ref": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "structure_id",
        "species",
        "formula",
        "input_format",
        "atom_id_scheme",
        "atom_ids",
        "elements",
        "charge",
        "multiplicity",
        "stereochemistry"
      ],
      "properties": {
        "structure_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique within its reaction side; part of every atom address."
        },
        "species": {
          "type": "string",
          "minLength": 1,
          "description": "Species label. Not a substitute for formula or atom identity."
        },
        "formula": {
          "type": "string",
          "minLength": 1,
          "pattern": "^([A-Z][a-z]?[0-9]*)+$",
          "description": "Hill-order elemental formula used by the element/stoichiometry conservation rule."
        },
        "input_format": {
          "enum": [
            "mol",
            "sdf",
            "smiles",
            "structure_upload"
          ],
          "description": "Initial supported input scope only. CDXML is DEFERRED; any other value is rejected explicitly, never best-effort parsed."
        },
        "atom_id_scheme": {
          "enum": [
            "explicit",
            "input_order_0_based"
          ],
          "description": "Declares how atom_ids were assigned. The serialized atom_ids remain the identity; ids are never regenerated from array position on round-trip."
        },
        "atom_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Stable per-structure atom identifiers. uniqueItems enforces no duplicate atom identity inside a structure."
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]?$"
          },
          "description": "Element symbol for atom_ids[i]. Parallel arrays must have equal length (scientific-semantics rule)."
        },
        "charge": {
          "type": "integer",
          "description": "Total formal charge of this species. Net charge is conserved across the reaction."
        },
        "multiplicity": {
          "type": "integer",
          "minimum": 1,
          "description": "Spin multiplicity (2S+1). Physical state multiplicity, not a guess/default."
        },
        "stereochemistry": {
          "$ref": "#/$defs/stereochemistry"
        }
      }
    },
    "atom_mapping": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "left_to_right",
        "right_to_left",
        "unmapped_left",
        "unmapped_right"
      ],
      "description": "One-to-one mapping. Object keys are unique by JSON structure, so left_to_right cannot contain a duplicate left atom and right_to_left cannot contain a duplicate right atom; the two maps must agree (scientific-semantics rule). Every atom must appear exactly once per side, either in the map or in the matching unmapped list.",
      "properties": {
        "left_to_right": {
          "type": "object",
          "minProperties": 0,
          "propertyNames": {
            "$ref": "#/$defs/atom_address"
          },
          "additionalProperties": {
            "$ref": "#/$defs/atom_address"
          }
        },
        "right_to_left": {
          "type": "object",
          "minProperties": 0,
          "propertyNames": {
            "$ref": "#/$defs/atom_address"
          },
          "additionalProperties": {
            "$ref": "#/$defs/atom_address"
          }
        },
        "unmapped_left": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/atom_address"
          }
        },
        "unmapped_right": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/atom_address"
          }
        }
      }
    },
    "bond_change": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "change_type",
        "left_atoms",
        "right_atoms",
        "bond_order_left",
        "bond_order_right"
      ],
      "anyOf": [
        {
          "required": [
            "left_atoms"
          ],
          "properties": {
            "left_atoms": {
              "type": "array"
            }
          }
        },
        {
          "required": [
            "right_atoms"
          ],
          "properties": {
            "right_atoms": {
              "type": "array"
            }
          }
        }
      ],
      "properties": {
        "change_type": {
          "enum": [
            "formed",
            "broken",
            "changed"
          ]
        },
        "left_atoms": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "$ref": "#/$defs/atom_address"
            },
            {
              "$ref": "#/$defs/atom_address"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Two atom addresses on the left. Null only when the change is product-defining."
        },
        "right_atoms": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "$ref": "#/$defs/atom_address"
            },
            {
              "$ref": "#/$defs/atom_address"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "Two atom addresses on the right. Null only when the change is reactant-defining."
        },
        "bond_order_left": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Bond order on the left side; 0 means not bonded. Null only when the left pair is unknown, never silently defaulted."
        },
        "bond_order_right": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Bond order on the right side; 0 means not bonded. Null only when the right pair is unknown, never silently defaulted."
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "temperature_k",
        "pressure_pa",
        "standard_state",
        "solvent",
        "phase"
      ],
      "description": "Conditions are explicit. Null is allowed only when the matching path is declared in input_uncertainty.unknown_fields; no implicit 298.15 K or 1 bar default exists.",
      "properties": {
        "temperature_k": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "pressure_pa": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "standard_state": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "1_bar_ideal_gas",
            "1_molar_ideal_solution",
            "unknown",
            null
          ]
        },
        "solvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "gas",
            "solution",
            "liquid",
            "solid",
            "unknown",
            null
          ]
        }
      }
    },
    "input_uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "propertyNames": {
        "not": {
          "enum": [
            "role",
            "model_role",
            "cost",
            "price",
            "job_status",
            "queue",
            "account"
          ]
        }
      },
      "required": [
        "unknown_fields",
        "notes"
      ],
      "description": "Declared omissions. A missing scientific value must appear here (for example conditions.temperature_k or left[0].stereochemistry.status) instead of being invented.",
      "properties": {
        "unknown_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
