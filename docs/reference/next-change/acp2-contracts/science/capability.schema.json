    ],
    "dialect": "https://json-schema.org/draft/2020-12/schema",
    "dialect_name": "draft-2020-12",
    "nullable_style": "type: [\"T\", \"null\"]",
    "range_style": "minimum/maximum",
    "restricted_validator_rule": "A restricted validator MUST reject any unsupported constraint keyword instead of ignoring it and MUST NOT silently skip a declared constraint.",
    "supported_keywords": [
      "$schema",
      "$id",
      "$defs",
