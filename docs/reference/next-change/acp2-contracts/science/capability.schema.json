{
  "$defs": {
    "compatibility": {
      "additionalProperties": false,
      "properties": {
        "backward_compatible_additions": {
          "const": "same_major_only"
        },
        "contract_version": {
          "const": "acp2.science.capability.v1"
        },
        "declared_major": {
          "maximum": 1,
          "minimum": 1,
          "type": "integer"
        },
        "historical_unknown_fields": {
          "const": "preserve_read_only_no_execution_or_recovery_eligibility"
        },
        "max_reader_schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "min_reader_schema_version": {
          "minimum": 1,
          "type": "integer"
        },
        "unknown_major_error_code": {
          "const": "unknown_major_version"
        },
        "unknown_major_version": {
          "const": "reject_and_never_execute"
        }
      },
      "required": [
        "contract_version",
        "declared_major",
        "min_reader_schema_version",
        "max_reader_schema_version",
        "unknown_major_version",
        "unknown_major_error_code",
        "historical_unknown_fields"
      ],
      "type": "object"
    },
    "completionCheck": {
      "additionalProperties": false,
      "properties": {
        "compares": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "description": {
          "pattern": "\\S",
          "type": "string"
        },
        "evaluator": {
          "pattern": "^cccp\\.[a-z0-9_.]+$",
          "type": "string"
        },
        "failure_error_code": {
          "enum": [
            "unknown_major_version",
            "duplicate_capability_id",
            "unknown_implementation",
            "disabled_provider",
            "unavailable_binary",
            "invalid_scientific_input"
          ]
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "description",
        "evaluator",
        "required",
        "failure_error_code"
      ],
      "type": "object"
    },
    "executionSemantics": {
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "delegates_to_task_kind": {
              "enum": [
                "singlepoint",
                "optimize",
                "frequency",
                "scan",
                "irc",
                "casscf",
                "thermochemistry",
                "conformer_search",
                "md_sampling",
                "clustering",
                "censo_refine",
                "nmr_shielding",
                "xtb_path_search",
                "orca_gradient",
                "xtb_constrained_opt"
              ],
              "type": "string"
            },
            "delegation_count": {
              "const": 1
            },
            "kind": {
              "const": "compute"
            },
            "reads_existing_artifacts_only": {
              "const": false
            },
            "side_effects": {
              "const": "artifacts_only"
            },
            "starts_subprocess": {
              "const": true
            },
            "writes_artifacts": {
              "const": true
            }
          }
        },
        {
          "properties": {
            "delegates_to_task_kind": {
              "const": null
            },
            "delegation_count": {
              "const": 0
            },
            "kind": {
              "const": "pure_analysis"
            },
            "reads_existing_artifacts_only": {
              "const": true
            },
            "side_effects": {
              "const": "none"
            },
            "starts_subprocess": {
              "const": false
            },
            "writes_artifacts": {
              "const": false
            }
          }
        }
      ],
      "properties": {
        "delegates_to_task_kind": {
          "oneOf": [
            {
              "enum": [
                "singlepoint",
                "optimize",
                "frequency",
                "scan",
                "irc",
                "casscf",
                "thermochemistry",
                "conformer_search",
                "md_sampling",
                "clustering",
                "censo_refine",
                "nmr_shielding",
                "xtb_path_search",
                "orca_gradient",
                "xtb_constrained_opt"
              ],
              "type": "string"
            },
            {
              "const": null
            }
          ]
        },
        "delegation_count": {
          "maximum": 1,
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "compute",
            "pure_analysis"
          ]
        },
        "network_access": {
          "const": false
        },
        "reads_existing_artifacts_only": {
          "type": "boolean"
        },
        "side_effects": {
          "enum": [
            "none",
            "artifacts_only"
          ]
        },
        "starts_subprocess": {
          "type": "boolean"
        },
        "writes_artifacts": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "starts_subprocess",
        "reads_existing_artifacts_only",
        "delegates_to_task_kind",
        "delegation_count",
        "side_effects",
        "network_access",
        "writes_artifacts"
      ],
      "type": "object"
    },
    "limitation": {
      "additionalProperties": false,
      "properties": {
        "applies_to": {
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "hard_limit"
          ]
        },
        "text": {
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "severity"
      ],
      "type": "object"
    },
    "precondition": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "pattern": "\\S",
          "type": "string"
        },
        "error_code": {
          "enum": [
            "unknown_major_version",
            "duplicate_capability_id",
            "unknown_implementation",
            "disabled_provider",
            "unavailable_binary",
            "invalid_scientific_input"
          ]
        },
        "evaluated_by": {
          "enum": [
            "contract",
            "cccp",
            "runtime"
          ]
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "software",
            "binary",
            "license",
            "input",
            "artifact",
            "scientific",
            "environment"
          ]
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "description",
        "required",
        "error_code"
      ],
      "type": "object"
    },
    "projection": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "pattern": "\\S",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "unknown",
            "present",
            "absent",
            "not_verified",
            "verified"
          ]
        }
      },
      "required": [
        "state"
      ],
      "type": "object"
    },
    "projections": {
      "additionalProperties": false,
      "properties": {
        "available": {
          "allOf": [
            {
              "$ref": "#/$defs/projection"
            },
            {
              "properties": {
                "state": {
                  "enum": [
                    "unknown",
                    "present",
                    "absent",
                    "not_verified"
                  ]
                }
              }
            }
          ]
        },
        "described": {
          "allOf": [
            {
              "$ref": "#/$defs/projection"
            },
            {
              "properties": {
                "state": {
                  "enum": [
                    "present"
                  ]
                }
              }
            }
          ]
        },
        "installed": {
          "allOf": [
            {
              "$ref": "#/$defs/projection"
            },
            {
              "properties": {
                "state": {
                  "enum": [
                    "unknown",
                    "present",
                    "absent",
                    "not_verified"
                  ]
                }
              }
            }
          ]
        },
        "verified": {
          "allOf": [
            {
              "$ref": "#/$defs/projection"
            },
            {
              "properties": {
                "state": {
                  "enum": [
                    "unknown",
                    "not_verified",
                    "verified"
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "described",
        "installed",
        "available",
        "verified"
      ],
      "type": "object"
    },
    "provenanceRequirements": {
      "additionalProperties": false,
      "properties": {
        "artifact_digests": {
          "const": "required"
        },
        "input_digest": {
          "const": "required"
        },
        "method_identity": {
          "enum": [
            "required",
            "not_applicable"
          ]
        },
        "notes": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "software_version": {
          "const": "required"
        },
        "units": {
          "const": "required"
        }
      },
      "required": [
        "software_version",
        "method_identity",
        "input_digest",
        "units",
        "artifact_digests"
      ],
      "type": "object"
    },
    "schemaReference": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "Either a science JSON-Schema URL or an existing CCCP contract identifier such as cccp.calculation.requests#TaskRequest.",
          "pattern": "^(https://acp\\.local/acp2/science/.+\\.schema\\.json(#.+)?|cccp\\.[a-z0-9_.]+#[A-Za-z0-9_]+)$",
          "type": "string"
        },
        "schema_version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "schema_version"
      ],
      "type": "object"
    },
    "unknownFieldPolicy": {
      "additionalProperties": false,
      "properties": {
        "extension_namespace": {
          "const": "x-acp2-<owner>-<name>"
        },
        "historical_read": {
          "const": "preserve_unknown_fields_without_execution_or_recovery_eligibility"
        },
        "new_execution_request": {
          "const": "reject_unsupported_execution_fields"
        },
        "unknown_major_version": {
          "const": "never_execute"
        }
      },
      "required": [
        "new_execution_request",
        "historical_read",
        "unknown_major_version",
        "extension_namespace"
      ],
      "type": "object"
    },
    "validationLayer": {
      "additionalProperties": false,
      "properties": {
        "checks": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "does_not_cover": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "type": "array"
        },
        "owner": {
          "enum": [
            "contract",
            "cccp",
            "runtime"
          ]
        }
      },
      "required": [
        "owner",
        "checks",
        "does_not_cover"
      ],
      "type": "object"
    },
    "validationLayers": {
      "additionalProperties": false,
      "properties": {
        "cccp_scientific_semantics": {
          "allOf": [
            {
              "$ref": "#/$defs/validationLayer"
            },
            {
              "properties": {
                "owner": {
                  "const": "cccp"
                }
              }
            }
          ]
        },
        "json_structure": {
          "allOf": [
            {
              "$ref": "#/$defs/validationLayer"
            },
            {
              "properties": {
                "owner": {
                  "const": "contract"
                }
              }
            }
          ]
        },
        "runtime_platform_constraints": {
          "allOf": [
            {
              "$ref": "#/$defs/validationLayer"
            },
            {
              "properties": {
                "owner": {
                  "const": "runtime"
                }
              }
            }
          ]
        }
      },
      "required": [
        "json_structure",
        "cccp_scientific_semantics",
        "runtime_platform_constraints"
      ],
      "type": "object"
    }
  },
  "$id": "https://acp.local/acp2/science/capability.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Frozen v1 descriptor for one scientific capability. The three validation layers are declared explicitly: JSON structure (contract), CCCP scientific semantics, and Runtime platform constraints. Described, installed, available and scientifically verified states are separate projections; installed or available never implies verified. This schema validates canonical new descriptors. Historical payloads with unknown fields are readable under unknown_field_policy.historical_read but gain no execution or recovery eligibility. Platform job status, account, queue and price fields are excluded by additionalProperties=false.",
  "properties": {
    "capability_id": {
      "description": "Dotted scientific capability id, for example electronic.energy.",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "compatibility": {
      "$ref": "#/$defs/compatibility"
    },
    "completion_checks": {
      "items": {
        "$ref": "#/$defs/completionCheck"
      },
      "type": "array"
    },
    "execution_semantics": {
      "$ref": "#/$defs/executionSemantics"
    },
    "extensions": {
      "additionalProperties": true,
      "description": "Namespaced x-acp2-<owner>-<name> extensions. Extension content is metadata only and never grants execution or recovery eligibility.",
      "type": "object"
    },
    "implementation_id": {
      "description": "The one implementation bound to this capability, for example cccp.calculation.tasks.singlepoint.",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "type": "string"
    },
    "input_schema": {
      "$ref": "#/$defs/schemaReference"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/limitation"
      },
      "type": "array"
    },
    "output_schema": {
      "$ref": "#/$defs/schemaReference"
    },
    "preconditions": {
      "items": {
        "$ref": "#/$defs/precondition"
      },
      "type": "array"
    },
    "projections": {
      "$ref": "#/$defs/projections"
    },
    "provenance_requirements": {
      "$ref": "#/$defs/provenanceRequirements"
    },
    "schema": {
      "const": "acp2.science.capability"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "unknown_field_policy": {
      "$ref": "#/$defs/unknownFieldPolicy"
    },
    "validation_layers": {
      "$ref": "#/$defs/validationLayers"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "capability_id",
    "implementation_id",
    "input_schema",
    "output_schema",
    "preconditions",
    "completion_checks",
    "limitations",
    "compatibility",
    "provenance_requirements",
    "execution_semantics",
    "validation_layers",
    "projections",
    "unknown_field_policy"
  ],
