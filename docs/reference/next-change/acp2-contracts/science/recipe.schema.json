{
  "$comment": "ACP2 science recipe, schema_version 1. A finite scientific DAG only: no job, queue, account, price or execution status field exists at any depth, and there is no scheduler/dispatch loop construct. Platform binding and execution state belong to track B and are never restated here.",
  "$defs": {
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "alternative_id": {
          "minLength": 1,
          "type": "string"
        },
        "max_uses": {
          "minimum": 1,
          "type": "integer"
        },
        "replaces_step_id": {
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": [
            "string",
            "null"
          ]
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "minItems": 1,
          "type": "array"
        },
        "when": {
          "minLength": 1,
          "type": "string"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "alternative_id",
        "when",
        "max_uses",
        "steps"
      ],
      "type": "object"
    },
    "Applicability": {
      "additionalProperties": false,
      "properties": {
        "preconditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "supported_reaction_classes": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "unsupported_when": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "supported_reaction_classes",
        "preconditions"
      ],
      "type": "object"
    },
    "Edge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "minLength": 1,
          "type": "string"
        },
        "from_step": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "output_ref": {
          "$ref": "#/$defs/OutputRef"
        },
        "to_step": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "edge_id",
        "from_step",
        "to_step"
      ],
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_alternatives": {
          "minimum": 0,
          "type": "integer"
        },
        "max_edges": {
          "minimum": 0,
          "type": "integer"
        },
        "max_steps": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "max_steps"
      ],
      "type": "object"
    },
    "OutputRef": {
      "additionalProperties": false,
      "properties": {
        "from_step": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "product_kind": {
          "minLength": 1,
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "selector": {
          "$ref": "#/$defs/Selector"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "from_step",
        "product_kind",
        "selector"
      ],
      "type": "object"
    },
    "SafeFieldName": {
      "$comment": "Instance field names are lowercase snake_case and may never contain the platform-binding tokens job/queue/account/price/status. The negative case job_status matches both the positive pattern and the not-pattern, so it is rejected.",
      "not": {
        "pattern": "(job|queue|account|price|status)"
      },
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "Selector": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "range": {
          "items": {
            "minimum": 0,
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "selector_kind": {
          "enum": [
            "whole_product",
            "index",
            "slice",
            "field",
            "conformer",
            "mode",
            "frame"
          ],
          "type": "string"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "selector_kind"
      ],
      "type": "object"
    },
    "Step": {
      "$comment": "Exactly one of capability_ref/task_kind is a non-null string. required and diagnostic_only are mutually exclusive; a diagnostic-only step can never satisfy a required downstream dependency.",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "properties": {
              "diagnostic_only": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "diagnostic_only": {
                "const": true
              }
            },
            "required": [
              "diagnostic_only"
            ]
          },
          "then": {
            "properties": {
              "required": {
                "const": false
              }
            }
          }
        }
      ],
      "oneOf": [
        {
          "properties": {
            "capability_ref": {
              "minLength": 1,
              "type": "string"
            },
            "task_kind": {
              "type": "null"
            }
          },
          "required": [
            "capability_ref"
          ]
        },
        {
          "properties": {
            "capability_ref": {
              "type": "null"
            },
            "task_kind": {
              "enum": [
                "singlepoint",
                "optimize",
                "frequency",
                "scan",
                "irc",
                "casscf",
                "thermochemistry",
                "conformer_search",
                "md_sampling",
                "clustering",
                "censo_refine",
                "nmr_shielding",
                "xtb_path_search",
                "orca_gradient",
                "xtb_constrained_opt"
              ],
              "type": "string"
            }
          },
          "required": [
            "task_kind"
          ]
        }
      ],
      "properties": {
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "type": "array"
        },
        "applicability": {
          "$ref": "#/$defs/Applicability"
        },
        "capability_ref": {
          "minLength": 1,
          "type": [
            "string",
            "null"
          ]
        },
        "consumes": {
          "items": {
            "$ref": "#/$defs/OutputRef"
          },
          "type": "array"
        },
        "diagnostic_only": {
          "type": "boolean"
        },
        "intent": {
          "description": "Scientific intent of the step, not a scheduler or dispatch instruction.",
          "minLength": 1,
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "items": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            },
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null",
              "array"
            ]
          },
          "propertyNames": {
            "$ref": "#/$defs/SafeFieldName"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "produces": {
          "items": {
            "$ref": "#/$defs/OutputRef"
          },
          "type": "array"
        },
        "required": {
          "type": "boolean"
        },
        "step_id": {
          "description": "Stable step id; referenced by edges, OutputRef.from_step and alternatives.",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "task_kind": {
          "enum": [
            "singlepoint",
            "optimize",
            "frequency",
            "scan",
            "irc",
            "casscf",
            "thermochemistry",
            "conformer_search",
            "md_sampling",
            "clustering",
            "censo_refine",
            "nmr_shielding",
            "xtb_path_search",
            "orca_gradient",
            "xtb_constrained_opt",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "validators": {
          "items": {
            "$ref": "#/$defs/ValidatorRef"
          },
          "type": "array"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "step_id",
        "intent",
        "required",
        "diagnostic_only"
      ],
      "type": "object"
    },
    "ValidatorRef": {
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "boolean"
        },
        "validator_id": {
          "minLength": 1,
          "pattern": "^(?:check|software|human)\\.[a-z0-9][a-z0-9_.-]*$",
          "type": "string"
        },
        "validator_version": {
          "minLength": 1,
          "pattern": "^[0-9][0-9A-Za-z.+-]*$",
          "type": "string"
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/SafeFieldName"
      },
      "required": [
        "validator_id",
        "validator_version",
        "required"
      ],
      "type": "object"
    }
  },
  "$id": "https://acp.local/acp2/science/recipe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Minimal but complete frozen recipe contract. Steps have stable step ids and reference either a registered capability or an existing TaskKind. Upstream products are selected with typed OutputRef selectors; edges, required/diagnostic-only flags, validators, applicability and bounded alternatives are explicit.",
  "properties": {
    "alternatives": {
      "items": {
        "$ref": "#/$defs/Alternative"
      },
      "type": "array"
    },
    "applicability": {
      "$ref": "#/$defs/Applicability"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/Edge"
      },
      "type": "array"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "recipe_id": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "science_identity": {
      "pattern": "^v2:[0-9a-f]{32}$",
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "validators": {
      "items": {
        "$ref": "#/$defs/ValidatorRef"
      },
      "type": "array"
    }
  },
  "propertyNames": {
    "$ref": "#/$defs/SafeFieldName"
  },
  "required": [
    "schema_version",
    "recipe_id",
    "applicability",
    "steps",
    "edges",
    "validators",
    "alternatives",
    "limits"
  ],
  "title": "ACP2 ScientificRecipe",
  "type": "object"
}
