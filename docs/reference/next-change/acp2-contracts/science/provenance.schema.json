{
  "$comment": "ACP2 science provenance, schema_version 1. Derivation is kind-specific: electronic_structure requires method+basis+electronic state, pure_analysis requires algorithm+version+input digest and must not invent a quantum method.",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "relative_path": {
          "description": "Artifact path relative to the run/evidence root. Absolute paths and parent traversal are rejected.",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "units": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "relative_path",
        "digest",
        "role"
      ],
      "type": "object"
    },
    "BasisIdentity": {
      "additionalProperties": false,
      "properties": {
        "auxiliary_basis_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis_family": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis_id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "basis_id"
      ],
      "type": "object"
    },
    "Conditions": {
      "$comment": "The three condition keys are required but nullable: an inapplicable condition must be declared as null, never silently omitted.",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "pressure_pascal": {
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        },
        "reference_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "solvent": {
          "type": [
            "string",
            "null"
          ]
        },
        "standard_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature_kelvin": {
          "exclusiveMinimum": 0,
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "temperature_kelvin",
        "standard_state",
        "reference_state"
      ],
      "type": "object"
    },
    "Digest": {
      "additionalProperties": false,
      "description": "Content digest. Mirrors cccp.analysis.identity: algorithm fixed to sha256, value is the bare lowercase hex digest (no algorithm prefix).",
      "properties": {
        "algorithm": {
          "enum": [
            "sha256"
          ],
          "type": "string"
        },
        "value": {
          "description": "Bare lowercase sha256 content digest, as returned by cccp.analysis.identity.content_sha256().",
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "value"
      ],
      "type": "object"
    },
    "ElectronicStateIdentity": {
      "additionalProperties": false,
      "properties": {
        "charge": {
          "type": "integer"
        },
        "multiplicity": {
          "minimum": 1,
          "type": "integer"
        },
        "spin_mode": {
          "description": "Mirrors cccp.calculation.contracts.SpinMode.",
          "enum": [
            "auto",
            "restricted",
            "unrestricted",
            "broken_symmetry",
            null
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "state_label": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "charge",
        "multiplicity"
      ],
      "type": "object"
    },
    "ElectronicStructureDerivation": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "$ref": "#/$defs/BasisIdentity"
        },
        "electronic_state": {
          "$ref": "#/$defs/ElectronicStateIdentity"
        },
        "method": {
          "$ref": "#/$defs/MethodIdentity"
        },
        "model_chemistry": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "method",
        "basis",
        "electronic_state"
      ],
      "type": "object"
    },
    "InputIdentity": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "type": "array"
        },
        "structure_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifacts"
      ],
      "type": "object"
    },
    "MethodIdentity": {
      "additionalProperties": false,
      "properties": {
        "dispersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "hamiltonian": {
          "type": [
            "string",
            "null"
          ]
        },
        "method_family": {
          "enum": [
            "dft",
            "wavefunction",
            "semiempirical",
            "force_field",
            "composite",
            "unknown"
          ],
          "type": "string"
        },
        "method_id": {
          "description": "Canonical quantum-chemistry method id (e.g. r2SCAN-3c, wB97X-D4, CCSD(T)).",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "method_id"
      ],
      "type": "object"
    },
    "PureAnalysisDerivation": {
      "$comment": "Pure analysis consumes existing products. A fabricated quantum method/basis/electronic state is rejected both by additionalProperties:false and by this explicit not-guard.",
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "required": [
              "method"
            ]
          },
          {
            "required": [
              "basis"
            ]
          },
          {
            "required": [
              "electronic_state"
            ]
          }
        ]
      },
      "properties": {
        "algorithm": {
          "minLength": 1,
          "type": "string"
        },
        "algorithm_version": {
          "minLength": 1,
          "pattern": "^[0-9][0-9A-Za-z.+-]*$",
          "type": "string"
        },
        "input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "algorithm",
        "algorithm_version",
        "input_digest"
      ],
      "type": "object"
    },
    "SoftwareIdentity": {
      "$comment": "software_version is required for electronic_structure and pure_analysis alike.",
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "software_id": {
          "minLength": 1,
          "type": "string"
        },
        "software_version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "software_id",
        "software_version"
      ],
      "type": "object"
    }
  },
  "$id": "https://acp.local/acp2/science/provenance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "result_kind": {
            "const": "electronic_structure"
          }
        },
        "required": [
          "result_kind"
        ]
      },
      "then": {
        "properties": {
          "derivation": {
            "$ref": "#/$defs/ElectronicStructureDerivation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result_kind": {
            "const": "pure_analysis"
          }
        },
        "required": [
          "result_kind"
        ]
      },
      "then": {
        "properties": {
          "derivation": {
            "$ref": "#/$defs/PureAnalysisDerivation"
          }
        }
      }
    }
  ],
  "description": "Derivation record for one scientific result. Software identity with an explicit version is required for both result kinds; temperature, standard state and reference state are declared (nullable) for both kinds.",
  "properties": {
    "conditions": {
      "$ref": "#/$defs/Conditions"
    },
    "derivation": {
      "type": "object"
    },
    "input": {
      "$ref": "#/$defs/InputIdentity"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "provenance_id": {
      "minLength": 1,
      "type": "string"
    },
    "result_kind": {
      "enum": [
        "electronic_structure",
        "pure_analysis"
      ],
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "science_identity": {
      "pattern": "^v2:[0-9a-f]{32}$",
      "type": [
        "string",
        "null"
      ]
    },
    "software": {
      "$ref": "#/$defs/SoftwareIdentity"
    }
  },
  "required": [
    "schema_version",
    "provenance_id",
    "result_kind",
    "software",
    "derivation",
    "input",
    "conditions"
  ],
  "schema_version": 1,
  "title": "ACP2 Provenance",
  "type": "object"
}
