{
  "$defs": {
    "errorCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "pattern": "\\S",
          "type": "string"
        },
        "detail_keys": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "type": "array"
        },
        "detail_required": {
          "const": true
        },
        "example": {
          "$ref": "#"
        },
        "layer": {
          "enum": [
            "structure",
            "scientific",
            "platform"
          ]
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "retryable",
        "layer",
        "detail_required",
        "detail_keys",
        "description",
        "example"
      ],
      "type": "object"
    },
    "errorRecord": {
      "$ref": "#",
      "description": "Alias used by other ACP2 science contracts (for example the task-binding unsupported-capability error) to reference this one record shape without copying it."
    }
  },
  "$id": "https://acp.local/acp2/science/errors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One frozen v1 error record shape and exactly six typed error codes. Each code is classified by layer (structure, scientific or platform), carries a fixed retryable value and requires structured detail; error_catalog records the code-specific detail keys and a valid example. An unknown major version is non-retryable and is never executed. The schema uses only standard draft-2020-12 validation keywords; nullable values use type arrays and numeric bounds use minimum/maximum.",
  "error_catalog": {
    "disabled_provider": {
      "description": "The provider exists but Runtime enablement policy disables it. Retrying without an explicit enablement change cannot succeed.",
      "detail_keys": [
        "provider",
        "enablement_policy",
        "plugin_name"
      ],
      "detail_required": true,
      "example": {
        "code": "disabled_provider",
        "detail": {
          "enablement_policy": "disabled-by-default",
          "plugin_name": "example.frequency-readout",
          "provider": "example"
        },
        "detail_required": true,
        "layer": "platform",
        "retryable": false
      },
      "layer": "platform",
      "retryable": false
    },
    "duplicate_capability_id": {
      "description": "Two descriptors or plugins declare the same capability id. A registry collection check reports the conflict instead of silently choosing one.",
      "detail_keys": [
        "capability_id",
        "existing_implementation_id",
        "conflicting_implementation_id"
      ],
      "detail_required": true,
      "example": {
        "code": "duplicate_capability_id",
        "detail": {
          "capability_id": "electronic.energy",
          "conflicting_implementation_id": "example.frequency.readout",
          "existing_implementation_id": "cccp.calculation.tasks.singlepoint"
        },
        "detail_required": true,
        "layer": "scientific",
        "retryable": false
      },
      "layer": "scientific",
      "retryable": false
    },
    "invalid_scientific_input": {
      "description": "A scientific precondition is violated (for example charge/multiplicity, structure role, method basis or electronic-state applicability). The value is rejected, never silently filled or coerced.",
      "detail_keys": [
        "field",
        "reason",
        "expected",
        "actual"
      ],
      "detail_required": true,
      "example": {
        "code": "invalid_scientific_input",
        "detail": {
          "actual": "odd electron count",
          "expected": "even electron count for multiplicity 1",
          "field": "charge",
          "reason": "charge and multiplicity are inconsistent"
        },
        "detail_required": true,
        "layer": "scientific",
        "retryable": false
      },
      "layer": "scientific",
      "retryable": false
    },
    "unavailable_binary": {
      "description": "A declared implementation cannot start because its runtime binary is absent. The environment probe reports NOT_VERIFIED, never PASS.",
      "detail_keys": [
        "software",
        "binary",
        "probe"
      ],
      "detail_required": true,
      "example": {
        "code": "unavailable_binary",
        "detail": {
          "binary": "orca",
          "probe": "resolve_executable('orca')",
          "software": "orca"
        },
        "detail_required": true,
        "layer": "platform",
        "retryable": false
      },
      "layer": "platform",
      "retryable": false
    },
    "unknown_implementation": {
      "description": "The requested capability or implementation id is not registered. This is the typed error for an unsupported capability selection.",
      "detail_keys": [
        "capability_id",
        "implementation_id"
      ],
      "detail_required": true,
      "example": {
        "code": "unknown_implementation",
        "detail": {
          "capability_id": "vibration.analyze",
          "implementation_id": "cccp.calculation.tasks.frequency_analysis"
        },
        "detail_required": true,
        "layer": "scientific",
        "retryable": false
      },
      "layer": "scientific",
      "retryable": false
    },
    "unknown_major_version": {
      "description": "A contract major version other than the supported v1 is rejected and never executed. Unknown major versions are non-retryable.",
      "detail_keys": [
        "contract_id",
        "declared_schema_version",
        "supported_schema_versions"
      ],
      "detail_required": true,
      "example": {
        "code": "unknown_major_version",
        "detail": {
          "contract_id": "capability.schema.json",
          "declared_schema_version": 2,
          "supported_schema_versions": [
            1
          ]
        },
        "detail_required": true,
        "layer": "structure",
        "retryable": false
      },
      "layer": "structure",
      "retryable": false
    }
  },
  "oneOf": [
    {
      "properties": {
        "code": {
          "const": "unknown_major_version"
        },
        "detail": {
          "properties": {
            "contract_id": {
              "pattern": "\\S",
              "type": "string"
            },
            "declared_schema_version": {
              "type": "integer"
            },
            "supported_schema_versions": {
              "items": {
                "type": "integer"
              },
              "type": "array"
            }
          },
          "required": [
            "contract_id",
            "declared_schema_version",
            "supported_schema_versions"
          ],
          "type": "object"
        },
        "detail_required": {
          "const": true
        },
        "layer": {
          "const": "structure"
        },
        "retryable": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "duplicate_capability_id"
        },
        "detail": {
          "properties": {
            "capability_id": {
              "pattern": "\\S",
              "type": "string"
            },
            "conflicting_implementation_id": {
              "pattern": "\\S",
              "type": "string"
            },
            "existing_implementation_id": {
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "capability_id",
            "existing_implementation_id",
            "conflicting_implementation_id"
          ],
          "type": "object"
        },
        "detail_required": {
          "const": true
        },
        "layer": {
          "const": "scientific"
        },
        "retryable": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "unknown_implementation"
        },
        "detail": {
          "properties": {
            "capability_id": {
              "pattern": "\\S",
              "type": "string"
            },
            "implementation_id": {
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "capability_id",
            "implementation_id"
          ],
          "type": "object"
        },
        "detail_required": {
          "const": true
        },
        "layer": {
          "const": "scientific"
        },
        "retryable": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "disabled_provider"
        },
        "detail": {
          "properties": {
            "enablement_policy": {
              "pattern": "\\S",
              "type": "string"
            },
            "plugin_name": {
              "pattern": "\\S",
              "type": "string"
            },
            "provider": {
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "provider",
            "enablement_policy",
            "plugin_name"
          ],
          "type": "object"
        },
        "detail_required": {
          "const": true
        },
        "layer": {
          "const": "platform"
        },
        "retryable": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "unavailable_binary"
        },
        "detail": {
          "properties": {
            "binary": {
              "pattern": "\\S",
              "type": "string"
            },
            "probe": {
              "pattern": "\\S",
              "type": "string"
            },
            "software": {
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "software",
            "binary",
            "probe"
          ],
          "type": "object"
        },
        "detail_required": {
          "const": true
        },
        "layer": {
          "const": "platform"
        },
        "retryable": {
          "const": false
        }
      }
    },
    {
      "properties": {
        "code": {
          "const": "invalid_scientific_input"
        },
        "detail": {
          "properties": {
            "actual": {},
            "expected": {},
            "field": {
              "pattern": "\\S",
              "type": "string"
            },
            "reason": {
              "pattern": "\\S",
              "type": "string"
            }
          },
          "required": [
            "field",
            "reason",
            "expected",
            "actual"
          ],
          "type": "object"
        },
        "detail_required": {
          "const": true
        },
        "layer": {
          "const": "scientific"
        },
        "retryable": {
          "const": false
        }
      }
    }
  ],
  "properties": {
    "code": {
      "enum": [
        "unknown_major_version",
        "duplicate_capability_id",
        "unknown_implementation",
        "disabled_provider",
        "unavailable_binary",
        "invalid_scientific_input"
      ]
    },
    "detail": {
      "additionalProperties": true,
      "description": "Required structured detail. Per-code required keys are declared in error_catalog[code].detail_keys and enforced by the matching oneOf branch.",
      "type": "object"
    },
    "detail_required": {
      "const": true
    },
    "layer": {
      "enum": [
        "structure",
        "scientific",
        "platform"
      ]
    },
    "message": {
      "pattern": "\\S",
      "type": [
        "string",
        "null"
      ]
    },
    "path": {
      "pattern": "\\S",
      "type": [
        "string",
        "null"
      ]
    },
    "retryable": {
      "type": "boolean"
    }
  },
  "required": [
    "code",
    "layer",
    "retryable",
    "detail",
    "detail_required"
  ],
  "schema_version": 1,
  "title": "ACP2 Science Error Contract",
  "type": "object"
}
