    "applicability": {
      "preconditions": [
        "frozen constructed endpoints: buta-1,3-diene + ethene and cyclohexene, gas phase, neutral closed-shell singlet",
        "one declared candidate path, one conformer per endpoint and one TS candidate (bounded cap)",
        "starting structures carry the frozen_known_candidate label; no generated_candidate or research-search claim",
        "same method, basis, electronic state, temperature, pressure, standard state, reference state and energy unit for every comparison",
        "execution-chain validation only: a control-loop PASS does not prove search capability"
      ],
      "supported_reaction_classes": [
        "net_reaction"
      ],
      "unsupported_when": [
        "an endo/exo selectivity question is requested (the symmetric example has no such distinction)",
        "a complete mechanism or exclusion of alternative paths is claimed",
        "a generated_candidate or research-search success is expected",
        "one IRC direction alone or one imaginary frequency is treated as connectivity proof",
        "the frozen method, basis, electronic state or comparison conditions are not matched",
        "an experimental rate, global minimum or general method accuracy is claimed"
      ]
    },
