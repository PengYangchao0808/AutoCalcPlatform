{
  "binding_id": "science.singlepoint",
  "binding_output": {
    "binding_metadata": {
      "capability_id": "electronic.energy",
      "context_serialized": false,
      "delegation_target": "cccp.calculation.run_singlepoint",
      "implementation_id": "cccp.calculation.tasks.singlepoint",
      "request_contract_ref": "cccp.calculation.requests#TaskRequest",
      "request_schema_version": 1,
      "resolved_task_kind": "singlepoint",
      "result_contract_ref": "cccp.calculation.results#TaskResult",
      "result_schema_version": 1,
      "selection_mode": "capability"
    },
    "request": {
      "charge": 0,
      "level": {
        "basis": "def2-TZVP",
        "method": "r2SCAN-3c"
      },
      "multiplicity": 1,
      "resources": {
        "mem": "2GB",
        "nproc": 2
      },
      "schema_version": 1,
      "structure": {
        "path": "structures/water.xyz",
        "role": "minimum",
        "source": "fixture"
      },
      "task": "singlepoint"
    },
    "request_json_validated_by": "cccp.calculation.requests.TaskRequest.from_dict"
  },
  "compatibility": {
    "contract_version": "acp2.science.task-binding.v1",
    "declared_major": 1,
    "existing_contract_versions": {
      "task_request": 1,
      "task_result": 1
    },
    "max_reader_schema_version": 1,
    "min_reader_schema_version": 1,
    "unknown_major_error_code": "unknown_major_version",
    "unknown_major_version": "reject_and_never_execute"
  },
  "context_contract": {
    "module": "cccp.calculation.context",
    "must_not_appear_as_field": true,
    "serialization_rule": "runtime_only_never_json",
    "serialized": false,
    "type": "TaskContext"
  },
  "delegation": {
    "entrypoint": "cccp.calculation.run_singlepoint",
    "entrypoint_module": "cccp.calculation.tasks",
    "max_invocations_per_binding": 1,
    "no_batch_or_chain": true,
    "no_second_executor": true,
    "single": true
  },
  "preflight": {
    "loads_plugins": false,
    "network": false,
    "outcomes": [
      "ready",
      "not_ready",
      "unsupported_capability"
    ],
    "platform_constraint_owner": "runtime",
    "side_effect_free": true,
    "starts_subprocess": false,
    "validates_json_structure": true,
    "validates_platform_constraints": false,
    "validates_scientific_preconditions": true,
    "writes_artifacts": false
  },
  "request_contract": {
    "authoritative": true,
    "execution_unknown_field_rule": "reject_unsupported_execution_fields_at_binding_preflight",
    "module": "cccp.calculation.requests",
    "parser": "TaskRequest.from_dict",
    "schema_version": 1,
    "schema_version_rule": "S1_reject_any_version_other_than_1",
    "serializer": "TaskRequest.to_dict",
    "type": "TaskRequest",
    "unknown_field_read_rule": "S2_ignore_unknown_fields_on_read"
  },
  "result_contract": {
    "authoritative": true,
    "module": "cccp.calculation.results",
    "parser": "TaskResult.from_dict",
    "schema_version": 1,
    "schema_version_rule": "S1_reject_any_version_other_than_1",
    "serializer": "TaskResult.to_dict",
    "type": "TaskResult",
    "unknown_field_read_rule": "S2_ignore_unknown_fields_on_read"
  },
  "schema": "acp2.science.task_binding",
  "schema_version": 1,
  "scientific_precondition_error": {
    "covers": [
      "charge_or_multiplicity",
      "structure_role",
      "method_or_basis",
      "electronic_state",
      "scientific_applicability"
    ],
    "detail_required": true,
    "error_code": "invalid_scientific_input",
    "error_schema_ref": "https://acp.local/acp2/science/errors.schema.json#/$defs/errorRecord",
    "layer": "scientific",
    "maps_from_error_kind": "invalid_input",
    "message_template": "Invalid scientific input for field {field}: {reason}",
    "retryable": false
  },
  "selection": {
    "capability_id": "electronic.energy",
    "mode": "capability",
    "task_kind": null
  },
  "unknown_field_policy": {
    "historical_read": "preserve_unknown_fields_without_execution_or_recovery_eligibility",
    "new_execution_request": "reject_unsupported_execution_fields_before_delegation",
    "task_context": "never_serialized_never_a_field",
    "unknown_major_version": "never_execute"
  },
  "unsupported_capability_error": {
    "covers": [
      "capability_not_in_registry",
      "capability_implementation_not_registered"
    ],
    "detail_required": true,
    "error_code": "unknown_implementation",
    "error_schema_ref": "https://acp.local/acp2/science/errors.schema.json#/$defs/errorRecord",
    "layer": "scientific",
    "maps_from_error_kind": "unsupported_capability",
    "message_template": "Capability {capability_id} has no registered implementation {implementation_id}.",
    "retryable": false
  },
  "validation_layers": {
    "cccp_scientific_semantics": {
      "checks": [
        "charge and multiplicity consistency",
        "structure role",
        "method and basis",
        "electronic state"
      ],
      "does_not_cover": [
        "JSON structure",
        "platform constraints"
      ],
      "owner": "cccp"
    },
    "json_structure": {
      "checks": [
        "required fields",
        "types",
        "enums",
        "patterns"
      ],
      "does_not_cover": [
        "scientific semantics",
        "platform constraints"
      ],
      "owner": "contract"
    },
    "runtime_platform_constraints": {
      "checks": [
        "enablement",
        "binary probes",
        "quota"
      ],
      "does_not_cover": [
        "JSON structure",
        "scientific semantics"
      ],
      "owner": "runtime"
    }
  }
}
