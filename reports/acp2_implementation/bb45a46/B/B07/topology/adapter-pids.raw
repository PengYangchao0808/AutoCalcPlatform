368283 /bin/bash -c export CI=true DEBIAN_FRONTEND=noninteractive GIT_TERMINAL_PROMPT=0 GCM_INTERACTIVE=never HOMEBREW_NO_AUTO_UPDATE=1 GIT_EDITOR=: EDITOR=: VISUAL='' GIT_SEQUENCE_EDITOR=: GIT_MERGE_AUTOEDIT=no GIT_PAGER=cat PAGER=cat npm_config_yes=true PIP_NO_INPUT=1 YARN_ENABLE_IMMUTABLE_INSTALLS=false; set -e EV=/ACPServer/AutoCalcPlatform/reports/acp2_implementation/bb45a46/B/B07; T="$EV/topology"; H2=58d81ec5ec528577692e6c1aa300c46fbf3b43c6 export ACP_CANDIDATE_REVISION="$H2" ACP2_EVIDENCE=/ACPServer/AutoCalcPlatform/reports/acp2_implementation/bb45a46 ACP2_DATA_ROOT=/ACPServer/acp2-development/data/b curl -fsS 'http://127.0.0.1:18765/api/v1/jobs?limit=1000' > "$T/jobs-before.json" python3 - <<'PY' import json d=json.load(open('/ACPServer/AutoCalcPlatform/reports/acp2_implementation/bb45a46/B/B07/topology/jobs-before.json')) j=d.get('jobs') if isinstance(d,dict) else None print('task_count_before',len(j) if isinstance(j,list) else 'unknown') print('statuses_before',sorted({x.get('status') for x in j} if isinstance(j,list) else [])) PY : > "$T/adapter-pids.raw" ( for i in $(seq 1 300); do pgrep -af "acp mcp serve --transport stdio --controller http://127.0.0.1:18765" >> "$T/adapter-pids.raw" 2>/dev/null || true; sleep 0.05; done ) & POLL=$! PY=/ACPServer/acp2-development/venvs/b/bin/python H=/ACPServer/AutoCalcPlatform/scripts/acceptance/acp2_runtime.py "$PY" "$H" --scenario entry-readonly --controller http://127.0.0.1:18765 --out "$T/entry-readonly-1" --timeout 60 > "$T/entry-readonly-1.log" 2>&1 & E1=$! "$PY" "$H" --scenario entry-readonly --controller http://127.0.0.1:18765 --out "$T/entry-readonly-2" --timeout 60 > "$T/entry-readonly-2.log" 2>&1 & E2=$! "$PY" "$H" --scenario mcp-stdio --controller http://127.0.0.1:18765 --launch "$T/mcp-launch-b07.json" --out "$T/mcp-stdio-1" --timeout 60 > "$T/mcp-stdio-1.log" 2>&1 & M1=$! "$PY" "$H" --scenario mcp-stdio --controller http://127.0.0.1:18765 --launch "$T/mcp-launch-b07.json" --out "$T/mcp-stdio-2" --timeout 60 > "$T/mcp-stdio-2.log" 2>&1 & M2=$! set +e wait $E1; R_E1=$?; wait $E2; R_E2=$?; wait $M1; R_M1=$?; wait $M2; R_M2=$?; set -e kill $POLL 2>/dev/null || true; wait $POLL 2>/dev/null || true echo "entry1=$R_E1 entry2=$R_E2 mcp1=$R_M1 mcp2=$R_M2" curl -fsS 'http://127.0.0.1:18765/api/v1/jobs?limit=1000' > "$T/jobs-after.json" curl -fsS 'http://127.0.0.1:18765/api/health' > "$T/controller-health-after.json" echo "--- adapter pid samples ---"; grep -o '^[0-9]* ' "$T/adapter-pids.raw" | tr -d ' ' | sort -u | tee "$T/adapter-pids.txt"; echo "remaining adapters:"; pgrep -af "acp mcp serve --transport stdio --controller http://127.0.0.1:18765" || echo NONE
