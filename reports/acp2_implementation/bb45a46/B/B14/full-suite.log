            try:
                barrier.wait(timeout=15)
                with TestClient(app) as client:
                    assert client.get("/api/status").status_code == 200
                    with outcomes_lock:
                        outcomes.append("ok")
                    release.wait(timeout=15)
            except RuntimeError as exc:
                with outcomes_lock:
                    outcomes.append(f"refused:{exc}")
    
