{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "acp2.acceptance.v1",
  "title": "ACP 2.0 acceptance receipt (three-track)",
  "description": "The single receipt contract shared by the A (science), B (runtime/platform) and C (experience/RPH) acceptance harnesses. Schema validity is necessary but not sufficient: the B01 validator also enforces the evidence-kind/operation-class platform-reference matrix, scenario/phase registry membership, alias normalization, artifact digests and cross-file reference resolution. See acceptance-harness.v1.md.",
  "type": "object",
  "required": [
    "schema",
    "schema_dialect",
    "contract_version",
    "owner",
    "scenario",
    "phase",
    "run_id",
    "candidate_revision",
    "candidate",
    "command",
    "cwd",
    "started_at",
    "finished_at",
    "result",
    "scope",
    "reason",
    "exit_code",
    "artifacts",
    "evidence_kind",
    "job_id",
    "operation_id",
    "attempt",
    "release_id",
    "submission_id",
    "manifest_generation",
    "negotiated_protocol",
    "extensions"
  ],
  "properties": {
    "schema": {
      "const": "acp2.acceptance.v1"
    },
    "schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic contract version. The B01 validator executes only major version 1; an unknown major version is rejected with unsupported_contract_version_major and never executed."
    },
    "owner": {
      "enum": ["B", "A", "C", "integration"]
    },
    "scenario": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9-]*(?::[a-z0-9][a-z0-9-]*)?$",
      "description": "Canonical scenario identity. B owns the 15 immutable unprefixed IDs. A uses science:* and C uses experience:*; C's runtime:* prefix is a display alias normalized to experience:*."
    },
    "phase": {
      "$ref": "#/$defs/phase"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"
    },
    "candidate_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$",
      "description": "Full source candidate identity; 40-hex Git SHA or sha256:<64-hex> source overlay."
    },
    "candidate": {
      "$ref": "#/$defs/candidate"
    },
    "command": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cwd": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    },
    "result": {
      "enum": ["PASS", "FAIL", "NOT_VERIFIED"]
    },
    "scope": {
      "enum": ["IN_SCOPE", "DEFERRED", "NOT_APPLICABLE"]
    },
    "reason": {
      "type": ["string", "null"]
    },
    "exit_code": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 255
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "job_id": {
      "type": ["string", "null"]
    },
    "operation_id": {
      "type": ["string", "null"]
    },
    "attempt": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "release_id": {
      "type": ["string", "null"]
    },
    "submission_id": {
      "type": ["string", "null"]
    },
    "manifest_generation": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "negotiated_protocol": {
      "type": ["string", "null"],
      "description": "Protocol version negotiated by a discovery probe, for example 2025-06-18 for MCP stdio."
    },
    "usage": {
      "type": ["object", "null"]
    },
    "evidence_kind": {
      "enum": ["fixture", "live", "aggregate"]
    },
    "readiness": {
      "enum": [
        "contract_ready",
        "implementation_ready",
        "integration_ready",
        "verified"
      ],
      "description": "Optional readiness carried by contract/dependency projections. The ingest-only alias deployed normalizes to integration_ready."
    },
    "delivery_status": {
      "enum": ["planned", "blocked"]
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sub_results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/subResult"
      },
      "description": "Aggregate child references. A parent aggregate lists every required child phase and never replaces a missing/failed child with its own PASS."
    },
    "run_key": {
      "type": ["string", "null"],
      "description": "A-owned compatibility field. New receipts may place it under extensions as science.run_key."
    },
    "receipt": {
      "type": ["object", "null"],
      "description": "A-owned compatibility field. New receipts may place it under extensions as science.receipt."
    },
    "platform": {
      "$ref": "#/$defs/platform",
      "description": "Ingest-only alias. Normalized to top-level platform references; a conflicting duplicate is rejected."
    },
    "claim_status": {
      "enum": [
        "supported",
        "refuted",
        "inconclusive",
        "not_evaluated"
      ],
      "description": "Scientific claim status, kept separate from the scenario result. A scenario PASS never implies a supported claim; a negative-honesty PASS leaves the claim inconclusive/refuted."
    },
    "h4_gate": {
      "enum": ["open", "closed"],
      "description": "H4 gate status, kept separate from both the scenario result and the scientific claim. Only real positive TS/IRC/comparable-energy rows plus the separate B20a-search row may close it."
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "enum": ["fixture"]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "fixture"
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "enum": ["live"]
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "live"
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "pattern": "(^|:)fixture$"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "fixture"
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "pattern": "(^|:)live$"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "live"
          }
        }
      }
    },
    {
      "if": {
        "required": ["phase"],
        "properties": {
          "phase": {
            "const": "aggregate"
          }
        }
      },
      "then": {
        "properties": {
          "evidence_kind": {
            "const": "aggregate"
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "candidate": {
      "type": "object",
      "required": ["server_revision", "client_revision", "harness_revision"],
      "properties": {
        "server_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "client_revision": {
          "$ref": "#/$defs/nullableString"
        },
        "harness_revision": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "required": ["name", "status"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["PASS", "FAIL", "NOT_VERIFIED"]
        },
        "detail": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "subResult": {
      "type": "object",
      "required": ["phase", "receipt", "result"],
      "properties": {
        "scenario": {
          "type": ["string", "null"]
        },
        "owner": {
          "enum": ["B", "A", "C", "integration"]
        },
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "receipt": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": ["PASS", "FAIL", "NOT_VERIFIED"]
        },
        "run_id": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "properties": {
        "job_id": {
          "type": ["string", "null"]
        },
        "operation_id": {
          "type": ["string", "null"]
        },
        "attempt": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "release_id": {
          "type": ["string", "null"]
        },
        "submission_id": {
          "type": ["string", "null"]
        },
        "manifest_generation": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "negotiated_protocol": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(?:\\.[a-z][a-z0-9_-]*)+$"
      },
      "additionalProperties": true,
      "description": "Namespaced extension object. Keys must carry a namespace (for example b.sample, da.required_child_phases, science.run_key, experience.operation_class). Un-namespaced keys are rejected; validation-layer or platform constraints never live in free-form top-level fields."
    },
    "phase": {
      "anyOf": [
        {
          "enum": [
            "main",
            "approval",
            "budget",
            "da-preflight",
            "da-submit",
            "da-evidence",
            "fixture",
            "live",
            "aggregate"
          ]
        },
        {
          "type": "string",
          "pattern": "^(?:science|experience|integration|da|infra|multitenant):[a-z0-9][a-z0-9-]*$"
        }
      ]
    }
  }
}
